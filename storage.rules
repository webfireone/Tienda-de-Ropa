rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && (request.auth.token.email in ['admin@tiendaropa.com', 'tiendaderopa@admin.com']
            || request.auth.uid == 'admin-001');
    }

    match /music/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && (request.auth.token.email in ['admin@tiendaropa.com', 'tiendaderopa@admin.com']
            || request.auth.uid == 'admin-001');
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
